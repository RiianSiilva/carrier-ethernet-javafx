<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<!-- Pane da topologia — permite posicionamento livre com layoutX e layoutY -->
<?import javafx.scene.layout.Pane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefWidth="800.0" prefHeight="520.0"
            style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javafx.ELanController">

    <Canvas fx:id="animCanvas"
            width="800" height="520"
            AnchorPane.topAnchor="0"
            AnchorPane.leftAnchor="0"/>

    <VBox style="-fx-background-color: transparent;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-padding: 16 24 16 24;
                     -fx-border-color: rgba(0,229,255,0.15);
                     -fx-border-width: 0 0 1 0;
                     -fx-background-color: transparent;">

            <Button text="← Menu"
                    onAction="#voltarMenu"
                    fx:id="voltarELan"
                    style="-fx-background-color: transparent;
                            -fx-border-color: rgba(255,255,255,0.15);
                            -fx-border-radius: 6;
                            -fx-background-radius: 6;
                            -fx-text-fill: rgba(255,255,255,0.5);
                            -fx-font-size: 12px;
                            -fx-cursor: hand;
                            -fx-padding: 5 12 5 12;"/>

            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="E-LAN"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #00e5ff;
                              -fx-letter-spacing: 2;"/>

                <Label text="ETHERNET LAN SERVICE"
                       style="-fx-font-size: 10px;
                              -fx-text-fill:#25a7b6;"/>

            </VBox>

            <Label text="MULTIPONTO A MULTIPONTO"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #25a7b6;
                          -fx-border-color: rgba(0,259,255,0.3);
                          -fx-border-radius: 4;
                          -fx-background-radius: 4;
                          -fx-padding: 4 10 4 10;"/>

        </HBox>

        <!-- VBox central que ocupa o espaço restante -->
        <VBox alignment="CENTER"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color: transparent;">

            <!-- Pane = único layout que permite posicionar filhos livremente com layoutX e layoutY -->
            <Pane fx:id="topoPane"
                  prefWidth="380" prefHeight="260"
                  style="-fx-background-color: transparent;">

                <!-- NÓ MATRIZ — centro da topologia -->
                <VBox alignment="CENTER" spacing="6"
                      layoutX="330" layoutY="60">

                    <Label text="🏦"
                           style="-fx-font-size: 28px;
                                  -fx-background-color: rgba(100,180,255,0.1);
                                  -fx-border-color: rgba(100,180,255,0.4);
                                  -fx-border-radius: 14;
                                  -fx-background-radius: 14;
                                  -fx-padding: 10 14 10 14;"/>

                    <Label text="Matriz"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>

                    <Label text="Sede Central"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>

                </VBox>
                <!-- NÓ AGÊNCIA SP — topo direita -->
                <VBox alignment="CENTER" spacing="6"
                      layoutX="330" layoutY="-35">
                    <Label text="🏧"
                           style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(0,229,255,0.06);
                                  -fx-border-color: rgba(0,229,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                    <Label text="Agência SP"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label text="São Paulo"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>

                <!-- NÓ AGÊNCIA RJ — direita -->
                <VBox alignment="CENTER" spacing="6"
                      layoutX="330" layoutY="168">
                    <Label text="🏧"
                           style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(0,229,255,0.06);
                                  -fx-border-color: rgba(0,229,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                    <Label text="Agência RJ"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label text="Rio de Janeiro"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>

                <!-- NÓ AGÊNCIA BH — baixo direita -->
                <VBox alignment="CENTER" spacing="6"
                      layoutX="240" layoutY="60">
                    <Label text="🏧"
                           style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(0,229,255,0.06);
                                  -fx-border-color: rgba(0,229,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                    <Label text="Agência BH"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label text="Belo Horizonte"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>

                <!-- NÓ AGÊNCIA POA — baixo esquerda -->
                <VBox alignment="CENTER" spacing="6"
                      layoutX="420" layoutY="60">
                    <Label text="🏧"
                           style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(0,229,255,0.06);
                                  -fx-border-color: rgba(0,229,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                    <Label text="Agência POA"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                    <Label text="Porto Alegre"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
                </VBox>

            </Pane>
            <!-- CAIXA DE DESCRIÇÃO -->
            <VBox alignment="CENTER"
                  style="-fx-background-color: rgba(0,229,255,0.04);
                         -fx-border-color: rgba(0,229,255,0.12);
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-padding: 16 24 16 24;
                         -fx-max-width: 580px;">

                <Label text="Este modelo faz com que todos os locais pareçam estar na mesma rede local (LAN)"
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-text-alignment: center;"/>

                <Label text="Qualquer agência pode falar diretamente com outra agência como um grande switch de rede virtual. É perfeito para empresas que precisam de colaboração total entre todas as suas filiais."
                       wrapText="true"
                       style="-fx-font-size: 12xp;
                              -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-text-alignment: center; -fx-padding: 8 0 0 0;"/>

            </VBox>

        </VBox>
    </VBox>

</AnchorPane>


