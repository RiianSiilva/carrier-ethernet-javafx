<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Pane?>

<AnchorPane prefWidth="800" prefHeight="520"
            style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javafx.ETreeController">

   <Canvas fx:id="animCanvas"
           width="800" height="520"
           AnchorPane.topAnchor="0"
           AnchorPane.leftAnchor="0"/>

   <VBox style="-fx-background-color: transparent;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
         AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

      <HBox alignment="CENTER_LEFT"
            spacing="20"
            style="-fx-padding: 16 24 16 24;
                     -fx-border-color: rgba(0,229,255,0.15);
                     -fx-border-width: 0 0 1 0;
                     -fx-background-color: transparent;">

         <Button text="← Menu"
                 onAction="#voltarMenu"
                 fx:id="voltarETree"
                 style="-fx-background-color: transparent;
                            -fx-border-color: rgba(255,255,255,0.15);
                            -fx-border-radius: 6;
                            -fx-background-radius: 6;
                            -fx-text-fill: rgba(255,255,255,0.5);
                            -fx-font-size: 12px;
                            -fx-cursor: hand;
                            -fx-padding: 5 12 5 12;"/>

         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="E-TREE"
                   style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #00e5ff;
                              -fx-letter-spacing: 2;"/>

            <Label text="Ethernet Tree Service"
                   style="-fx-font-size: 10px;
                              -fx-text-fill:#25a7b6;"/>

         </VBox>

         <Label text="PONTO A MULTIPONTO"
                style="-fx-font-size: 10px;
                          -fx-text-fill: #25a7b6;
                          -fx-border-color: rgba(0,259,255,0.3);
                          -fx-border-radius: 4;
                          -fx-background-radius: 4;
                          -fx-padding: 4 10 4 10;"/>

      </HBox>

      <!-- VBox central — ocupa o espaço restante -->
       <VBox alignment="CENTER"
             spacing="28"
             VBox.vgrow="ALWAYS"
             style="-fx-background-color: transparent;">

          <!-- Pane da topologia — posicionamento livre -->
          <Pane fx:id="topoPane"
                prefWidth="520" prefHeight="220"
                style="-fx-background-color: transparent;">

             <!-- ROOT — Netflix no topo centro -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="350" layoutY="-30">
                <Label text="🎬"
                       style="-fx-font-size: 28px;
                              -fx-background-color: rgba(0,255,180,0.1);
                              -fx-border-color: rgba(0,255,180,0.4);
                              -fx-border-radius: 14;
                              -fx-background-radius: 14;
                                  -fx-padding: 10 14 10 14;"/>
                <Label text="Netflix"
                       style="-fx-font-size: 11px;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>
                <Label text="ROOT"
                       style="-fx-font-size: 9px;
                              -fx-text-fill: #00ffb4;
                              -fx-border-color: rgba(0,255,180,0.3);
                              -fx-border-radius: 3;
                              -fx-padding: 2 6 2 6;"/>
             </VBox>
             <!-- LEAF — Cliente SP -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="150" layoutY="110">
                <Label text="📺"
                       style="-fx-font-size: 24px;
                              -fx-background-color: rgba(100,180,255,0.06);
                              -fx-border-color: rgba(100,180,255,0.25);
                              -fx-border-radius: 12;
                              -fx-background-radius: 12;
                              -fx-padding: 8 12 8 12;"/>
                <Label text="Client SP"
                       style="-fx-font-size: 10px;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>
                <Label text="São Paulo"
                       style="-fx-font-size: 9px;
                              -fx-text-fill: rgba(255,255,255,0.4);"/>
             </VBox>
             <!-- LEAF — Cliente RJ -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="250" layoutY="110">
                <Label text="📺"
                       style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(100,180,255,0.06);
                                  -fx-border-color: rgba(100,180,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                <Label text="Cliente RJ"
                       style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                <Label text="Rio de Janeiro"
                       style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
             </VBox>

             <!-- LEAF — Cliente BH -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="350" layoutY="110">
                <Label text="📺"
                       style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(100,180,255,0.06);
                                  -fx-border-color: rgba(100,180,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                <Label text="Cliente BH"
                       style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                <Label text="Belo Horizonte"
                       style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
             </VBox>

             <!-- LEAF — Cliente POA -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="450" layoutY="110">
                <Label text="📺"
                       style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(100,180,255,0.06);
                                  -fx-border-color: rgba(100,180,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                <Label text="Cliente POA"
                       style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                <Label text="Porto Alegre"
                       style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
             </VBox>

             <!-- LEAF — Cliente BSB -->
             <VBox alignment="CENTER" spacing="6"
                   layoutX="550" layoutY="110">
                <Label text="📺"
                       style="-fx-font-size: 24px;
                                  -fx-background-color: rgba(100,180,255,0.06);
                                  -fx-border-color: rgba(100,180,255,0.25);
                                  -fx-border-radius: 12;
                                  -fx-background-radius: 12;
                                  -fx-padding: 8 12 8 12;"/>
                <Label text="Cliente BSB"
                       style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                <Label text="Brasília"
                       style="-fx-font-size: 9px;
                                  -fx-text-fill: rgba(255,255,255,0.4);"/>
             </VBox>
          </Pane>
      <!-- CAIXA DE DESCRIÇÃO -->
      <VBox alignment="CENTER"
            style="-fx-background-color: rgba(0,229,255,0.04);
                         -fx-border-color: rgba(0,229,255,0.12);
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-padding: 16 24 16 24;
                         -fx-max-width: 580px;">

         <Label text="É uma rede hierárquica. A Raiz envia dados para todas as Folhas, mas as Folhas só podem se comunicar de volta com a Raiz. "
                wrapText="true"
                style="-fx-font-size: 12px;
                              -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-text-alignment: center;"/>

         <Label text="Elas não conversam entre si. Essencial para distribuição de conteúdo centralizado ou serviços de acesso onde a privacidade entre clientes é necessária."
                wrapText="true"
                style="-fx-font-size: 12xp;
                              -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-text-alignment: center; -fx-padding: 8 0 0 0;"/>

      </VBox>
       </VBox>

   </VBox>


</AnchorPane>
