<?xml version="1.0" encoding="UTF-8"?>
<!--Declaração padrão de td arquivo XML -->
<!-- version = "1.0" = versão do XML -->
<!-- enconding = "UTF-8" = norma para suportar acentos e caracteres especiais -->


<!-- IMPORTS: assim como no java, cada componente que vc usa precisa ser importado -->
<!-- ArchoPane = layout que permite posicionar elementos com âncora (top, bottom, left, right) -->
<?import javafx.scene.layout.AnchorPane?>

<!-- Canvas = uma "tela em Branco" onde desenhamos via código java (usaremos nas animações)-->
<?import javafx.scene.canvas.Canvas?>

<!-- Button = botão clicavel -->
<?import javafx.scene.control.Button?>

<!-- Label = texto não editável, usado para títulos e descrições-->
<?import javafx.scene.control.Label?>

<!-- VBox = layout que empilha filhos na vertical (um embaixo do outro)-->
<?import javafx.scene.layout.VBox?>

<!-- HBox = layout que enfileira filhos na horizontal (um do lado do outro)-->
<?import javafx.scene.layout.HBox?>

<!-- ELEMENTO RAIZ = AnchorPane é o container principal da tela inteira -->
<!-- prefWidth e prefHeight = tamanho preferido da janela em pixels -->
<!-- style = CSS inline do javaFx, (sempre com prefixo -fx-)-->
<!-- xmlns = namespace padrão do javaFx, senpre igual-->
<!-- xmlns:fx = namespace que habilita atributos especiais como fx:id e fx:controller-->
<!-- fx:controller = qual classe java controla esta tela-->
<AnchorPane prefWidth="800.0" prefHeight="520"
            style="-fx-background-color: #000000;"
            xmlns ="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javafx.MenuController">
   <!-- CANVAS DA ANIMAÇÃO -->
   <!-- fx:id="animCanvas" nome pelo qual o Controller vai acessar este elemento via @FXML -->
   <!-- width e height = tamnho do canvas em pixels (igual ao AnchorPane para cobrir tudo) -->
   <!-- AnchoPane.toptAnchor = "0" = gruda no topo do AnchorPane -->
   <!-- AnchoPane.leftAnchor = "0" = gruda na esquerda -->
   <!-- Resultado = o canvas cobre 100% do fundo da tela -->
   <Canvas fx:id="animCanvas"
           width="800" height="520"
           AnchorPane.topAnchor="0"
           AnchorPane.leftAnchor="0"/>

   <!-- VBox CENTRAL: contém o título e os botões-->
   <!-- aligment = "CENTER" = centraliza todos os filhos horizontal e verticalmente -->
   <!-- spacing = "0" = espaço entre os filhos (vamos controlar o espaço pelo podding de cada um) -->
   <!-- As 4 âncoras = 0 fazem o VBox ocupar td o AnchorPane -->
   <!-- Isso garante que o conteúdo fique centralizado na tela inteira -->
   <VBox alignment="CENTER" spacing="0"
         style="-fx-background-color: transparent;"
         AnchorPane.topAnchor="0"
         AnchorPane.bottomAnchor="0"
         AnchorPane.leftAnchor="0"
         AnchorPane.rightAnchor="0">

      <!-- TÍTULO PRINCIPAL -->
      <!-- text = o texto exibido -->
      <!-- -fx-font-size- = tamanho da fonte em pixels -->
      <!-- -fx-font-weight: bold = negrito -->
      <!-- -fx-text-fill = cor do texto (branco) -->
      <!-- -fx-letter-spacing = espaçamento entre letras -->
      <Label text=" CARRIER&#10;ETHERNET"
             style = "-fx-font-size: 42px;
                     -fx-font-weight: bold;
                     -fx-text-fill: white;
                     -fx-letter-spacing: 4;"/>

      <!-- SUBTÍTULO-->
      <!-- -fx-text-fill: #00e5ff = azul ciano -->
      <!-- -fx-padding: 8 0 24 0 = espaço interno: top right bottom left -->
      <!-- 8px acima, 0 direita, 24px abaixo (empurra os botões para baixo), 0 esquerda -->
      <Label text="Metro Ethernet Forum · IEEE 802.3"
             style="-fx-font-size: 12px;
                     -fx-text-fill: #00e5ff;
                     -fx-padding: 8 0 24 0;"/>

      <!-- HBox DOS BOTÕES: coloca os 3 botões lado a lado-->
      <!-- aligment ="CENTER" = centraliza os botões dentro do HBox-->
      <!-- spacing = "20" = 20px de espaço entre cada botão -->
      <HBox alignment="CENTER" spacing="20">

         <!-- BOTÃO E-LINE -->
         <!-- fx:id = nome para acessar no controller se precisar mudar algo por código-->
         <!-- onAcition = "#openELine" = quando clicado, chama o métdo openELine() no controller-->
         <!-- &#10; = quebra de linha dentro do texto (equivalente ao \n)-->
         <!-- -fx-background-color: transparent = sem fundo só a borda aparece -->
         <!-- -fx-border-color = cor da borda -->
         <!-- -fx-border-radius = arredondamento da borda -->
         <!-- -fx-background-radius = arredondamento do fundo (deve ser igual ao border-radius) -->
         <!-- -fx-pref-width e -fx-pref-height = tamanho preferido do botão -->
         <!-- -fx-cursor: hand = muda o cursor para mãozinha ao passar por cima -->
         <Button fx:id="btnELine"
                 text="E-Line&#10;Point-to-Point"
                 onAction="#openELine"
                 style="-fx-background-color: transparent;
                         -fx-border-color: #00e5ff;
                         -fx-border-radius: 10;
                         -fx-background-radius: 10;
                         -fx-text-fill: #00e5ff;
                         -fx-font-size: 14px;
                         -fx-font-weight: bold;
                         -fx-pref-width: 160px;
                         -fx-pref-height: 80px;
                         -fx-cursor: hand;"/>

         <!-- BOTÃO E-LAN -->
         <!-- Idêntico ao E-Line, mas com cor azul mais clara (#64b4ff) -->
         <!-- e chama o métdo openELan() -->
         <Button fx:id="btnELan"
                 text="E-LAN&#10;Multipoint-to-Multipoint"
                 onAction="#openELan"
                 style="-fx-background-color: transparent;
                           -fx-border-color: #64b4ff;
                           -fx-border-radius: 10;
                           -fx-background-radius: 10;
                           -fx-text-fill: #64b4ff;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-pref-width: 160px;
                           -fx-pref-height: 80px;
                           -fx-cursor: hand;"/>

         <!-- BOTÃO E-TREE -->
         <!-- Cor verde-ciano (#00ffb4) e chama openETree() -->
         <Button fx:id="btnETree"
                 text="E-Tree&#10;Rooted-Multipoint"
                 onAction="#openETree"
                 style="-fx-background-color: transparent;
                           -fx-border-color: #00ffb4;
                           -fx-border-radius: 10;
                           -fx-background-radius: 10;
                           -fx-text-fill: #00ffb4;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-pref-width: 160px;
                           -fx-pref-height: 80px;
                           -fx-cursor: hand;"/>

      </HBox>
         <!-- fim do HBox dos botões -->
    </VBox>
       <!-- fim do VBox central -->
</AnchorPane>
   <!-- fim do elemento raiz - tdo FXML termina fechando a tag raiz -->